# This file is for running curator FROM SOURCE, on a development machine.
#
# It is not the container's configuration and not a template for one. If you are
# running the published image, you have `compose.yaml` and the Settings screen
# instead, and between them they need almost nothing from you: the TMDB key, the
# WireGuard tunnel, the indexers and Jellyfin's URL are all written from the
# browser and stored encrypted (docs/decisions.md D28). The compose file carries
# only what curator needs in order to reach that screen.
#
# So: copy to .env, and set what you actually want to exercise. Every value below
# is optional except TMDB_API_KEY, and an empty one degrades a feature rather than
# failing startup — the library still scans, search still works, and the log says
# at startup which of them are off.
#
# A stored setting beats this file for anything the Settings screen owns, EXCEPT
# where a variable here is set: an environment value wins and the screen shows the
# row as locked, which is why a stale .env is worth deleting rather than emptying.

# TMDB key: themoviedb.org -> Settings -> API (free). Without it the library
# scans but nothing is matched, Discover is unavailable, and Search falls back to
# release names.
TMDB_API_KEY=

# The fixture library — 29 directories mirroring the real one, 3 with a video
# file and 26 with only a .gitkeep, so a fresh clone does something useful
# immediately. Point it at real films when you want real films.
LIBRARY_MOVIES=./testdata/library/movies
PORT=8090

# --- indexers ----------------------------------------------------------------
# All optional; these are the defaults.
#
# 127.0.0.1, not localhost: minter binds IPv4 only, so localhost resolves to ::1
# first and the connection fails. Inside Docker the service name resolves, and
# compose.yaml sets MINTER_URL=http://minter:8191 for exactly that reason.
MINTER_URL=http://127.0.0.1:8191
SEARCH_TIMEOUT=30s
SEARCH_CACHE_TTL=1h

# --- the download, and the tunnel it goes through -----------------------------
#
# TORRENT_BACKEND is `embedded` (curator's own engine, in this process) or
# `qbittorrent` (an external one, as phases 3-5 shipped). Embedded is the
# default and is the only one curator can promise a VPN for, because it is the
# only one whose socket curator owns. An unknown value is a startup error.
TORRENT_BACKEND=embedded
# Where the embedded engine writes payloads. It hardlinks into LIBRARY_MOVIES
# from here, so the two want to be on the same filesystem (D8).
DOWNLOADS_DIR=./downloads
# Per-torrent peer cap and the listen port. Both optional: 24 conns, and an
# ephemeral port. Set TORRENT_PORT only if a VPN provider forwards one.
# TORRENT_MAX_CONNS=24
# TORRENT_PORT=0
# How long a torrent may gain nothing before it reports itself stalled instead
# of queued.
TORRENT_STALL_AFTER=5m

# VPN_CONFIG is a wg-quick .conf verbatim, VPN_CONFIG_FILE is the path to one;
# a provider gives you the file. Only the torrent engine is routed through it —
# the UI, TMDB, the indexers and Jellyfin stay on this machine's own connection,
# so a bad tunnel cannot lock you out of the app.
#
# VPN_REQUIRED defaults to TRUE: with the embedded engine and no tunnel,
# dispatch is refused. That is what "mandatory" means, and turning it off has to
# be typed.
# VPN_CONFIG_FILE=/path/to/wg0.conf
VPN_REQUIRED=true
# Where to ask for the exit address, to prove the tunnel changes it. Cloudflare's
# by default; any endpoint that answers `ip=1.2.3.4` or a bare address works.
# VPN_IP_CHECK_URL=https://www.cloudflare.com/cdn-cgi/trace

# --- qBittorrent, the second backend -----------------------------------------
# Everything in this block applies to TORRENT_BACKEND=qbittorrent ONLY, and can
# be ignored entirely on the default.
#
# QBIT_USER and QBIT_PASS are the qBittorrent Web UI login; leaving them empty is
# supported — dispatch reports itself unconfigured and no poller starts.
QBIT_URL=http://127.0.0.1:8080
QBIT_USER=
QBIT_PASS=
# Category *and* tag applied to everything curator adds, with its own save path so
# a side-by-side run with radarr cannot have two importers in one directory (D13).
QBIT_CATEGORY=curator
DOWNLOAD_POLL_INTERVAL=10s

# The path pair, also qBittorrent-only: the embedded engine has one filesystem
# and nothing to translate. DOWNLOADS_PATH is what curator sees;
# QBIT_DOWNLOADS_PATH is the same directory as qBittorrent sees it. Leaving
# DOWNLOADS_PATH empty means "use the path qBittorrent reported verbatim", which
# is right whenever curator shares qBittorrent's mount. Setting it and having a
# content path that does NOT start with QBIT_DOWNLOADS_PATH is an error, not a
# silent pass-through.
DOWNLOADS_PATH=
QBIT_DOWNLOADS_PATH=/downloads

# --- Jellyfin ----------------------------------------------------------------
# Optional. An empty JELLYFIN_API_KEY disables the library refresh without
# failing startup — the import still happens and Jellyfin finds the file on its
# own schedule (D15), and a film's page shows no Open in Jellyfin link.
#
# Left empty rather than defaulted, because curator WRITES this one: the
# provisioner records where it put a Jellyfin, and adoption records the one you
# typed. A value here beats both and locks the row.
JELLYFIN_URL=
JELLYFIN_API_KEY=

# --- updates -----------------------------------------------------------------
# UPDATE_CHECK defaults on. It reads a public GitHub endpoint and sends nothing
# about the install, but it is still a request a media server makes on its own,
# so it is a switch. UPDATER_URL points at something that can install one;
# without it the Settings card shows the command to paste, which is not an error.
# UPDATE_CHECK=true
# UPDATER_URL=
# UPDATER_TOKEN=

# The import destination is LIBRARY_MOVIES, above. It is deliberately the same
# directory the scanner reads: an importer writing anywhere else would produce
# movies the scanner never sees.
