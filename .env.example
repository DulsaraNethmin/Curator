# Copy to .env and fill in. TMDB key: themoviedb.org -> Settings -> API (free).
TMDB_API_KEY=
LIBRARY_MOVIES=./testdata/library/movies
PORT=8090

# Phase 2 — indexers. All optional; these are the defaults.
# 127.0.0.1, not localhost: minter binds IPv4 only, so localhost resolves to ::1
# first and the connection fails. Inside Docker, use http://minter:8191.
MINTER_URL=http://127.0.0.1:8191
SEARCH_TIMEOUT=30s
SEARCH_CACHE_TTL=1h

# Phase 3 — downloads. QBIT_USER and QBIT_PASS are the qBittorrent Web UI login;
# leaving them empty is supported — the library still scans and search still
# works, only dispatch reports itself unconfigured and no poller starts.
#
# qBittorrent shares gluetun's network namespace and has no ports of its own, so
# it is http://gluetun:8080 inside Docker and 192.168.1.26:8080 from a laptop.
QBIT_URL=http://192.168.1.26:8080
QBIT_USER=
QBIT_PASS=
# Category *and* tag applied to everything curator adds, with its own save path so
# a side-by-side run with radarr cannot have two importers in one directory (D13).
QBIT_CATEGORY=curator
DOWNLOAD_POLL_INTERVAL=10s
