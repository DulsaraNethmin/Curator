# Copy to .env and fill in. TMDB key: themoviedb.org -> Settings -> API (free).
TMDB_API_KEY=
LIBRARY_MOVIES=./testdata/library/movies
PORT=8090

# Phase 2 — indexers. All optional; these are the defaults.
# 127.0.0.1, not localhost: minter binds IPv4 only, so localhost resolves to ::1
# first and the connection fails. Inside Docker, use http://minter:8191.
MINTER_URL=http://127.0.0.1:8191
SEARCH_TIMEOUT=30s
SEARCH_CACHE_TTL=1h

# Phase 6 — curator downloads it itself.
#
# TORRENT_BACKEND is `embedded` (curator's own engine, in this process) or
# `qbittorrent` (an external one, as phases 3-5 shipped). Embedded is the
# default and is the only one curator can promise a VPN for, because it is the
# only one whose socket curator owns. An unknown value is a startup error.
TORRENT_BACKEND=embedded
# Where the embedded engine writes payloads. It hardlinks into LIBRARY_MOVIES
# from here, so the two want to be on the same filesystem (D8).
DOWNLOADS_DIR=./downloads
# Per-torrent peer cap and the listen port. Both optional: 24 conns, and an
# ephemeral port. Set TORRENT_PORT only if a VPN provider forwards one.
# TORRENT_MAX_CONNS=24
# TORRENT_PORT=0
# How long a torrent may gain nothing before it reports itself stalled instead
# of queued.
TORRENT_STALL_AFTER=5m

# The tunnel. VPN_CONFIG is a wg-quick .conf verbatim, VPN_CONFIG_FILE is the
# path to one; a provider gives you the file. Only the torrent engine is routed
# through it — the UI, TMDB, the indexers and Jellyfin stay on this machine's
# own connection, so a bad tunnel cannot lock you out of the app.
#
# VPN_REQUIRED defaults to TRUE: with the embedded engine and no tunnel,
# dispatch is refused. That is what "mandatory" means, and turning it off has to
# be typed.
# VPN_CONFIG_FILE=/config/wg0.conf
VPN_REQUIRED=true
# Where to ask for the exit address, to prove the tunnel changes it. Cloudflare's
# by default; any endpoint that answers `ip=1.2.3.4` or a bare address works.
# VPN_IP_CHECK_URL=https://www.cloudflare.com/cdn-cgi/trace

# Phase 3 — downloads. These apply to TORRENT_BACKEND=qbittorrent only.
# QBIT_USER and QBIT_PASS are the qBittorrent Web UI login;
# leaving them empty is supported — the library still scans and search still
# works, only dispatch reports itself unconfigured and no poller starts.
#
# qBittorrent shares gluetun's network namespace and has no ports of its own, so
# it is http://gluetun:8080 inside Docker and 192.168.1.26:8080 from a laptop.
QBIT_URL=http://192.168.1.26:8080
QBIT_USER=
QBIT_PASS=
# Category *and* tag applied to everything curator adds, with its own save path so
# a side-by-side run with radarr cannot have two importers in one directory (D13).
QBIT_CATEGORY=curator
DOWNLOAD_POLL_INTERVAL=10s

# Phase 4 — import. All optional; these are the defaults, and the path pair
# applies to TORRENT_BACKEND=qbittorrent only: the embedded engine has one
# filesystem and nothing to translate.
#
# DOWNLOADS_PATH is what curator sees; QBIT_DOWNLOADS_PATH is the same directory
# as qBittorrent sees it (its mount is host /media/storage/media/downloads ->
# container /downloads, so every path it reports starts with /downloads).
# Leaving DOWNLOADS_PATH empty means "use the path qBittorrent reported
# verbatim", which is right on a laptop and right whenever curator shares
# qBittorrent's mount. Setting it and having a content path that does NOT start
# with QBIT_DOWNLOADS_PATH is an error, not a silent pass-through.
DOWNLOADS_PATH=
QBIT_DOWNLOADS_PATH=/downloads

# Jellyfin is 10.10.7 at 192.168.1.26:8096, and http://jellyfin:8096 in Docker.
# An empty JELLYFIN_API_KEY disables the library refresh without failing
# startup, the same as an empty TMDB_API_KEY or QBIT_USER — the import still
# happens and Jellyfin finds the file on its own schedule (D15).
JELLYFIN_URL=http://192.168.1.26:8096
JELLYFIN_API_KEY=

# The import destination is LIBRARY_MOVIES, above. It is deliberately the same
# directory the scanner reads: an importer writing anywhere else would produce
# movies the scanner never sees.
