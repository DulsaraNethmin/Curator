# Anchored: an unanchored "curator" also matches the cmd/curator/ directory,
# which silently excluded the whole command from git.
/curator
*.db
*.db-shm
*.db-wal
.env
# Any backup of it too: .env carries TMDB_API_KEY and QBIT_PASS, and a
# `.env.bak-...` left by an editor or a script is not covered by the line above.
# One got as far as `git status` before this was noticed.
.env.*
!.env.example
.DS_Store
/web/node_modules/
/web/out/
/web/.next/

# The Next.js export is generated, not committed: minified bundles make every UI
# change an unreviewable diff (D16). The directory itself must exist, though —
# //go:embed is a compile-time directive and a missing dist/ is a build failure,
# on a fresh clone and under every `git bisect` step alike.
/internal/web/dist/*
!/internal/web/dist/.gitkeep
.idea/
.vscode/
